# ============================================================
# FANTA — Variables d'environnement (EXEMPLE)
# Copiez ce fichier en ".env" puis renseignez vos valeurs.
# NE JAMAIS committer le fichier .env réel.
# ============================================================

# URL PostgreSQL fournie par Neon (celle que vous me transmettez).
# Exemple de format :
# postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Clé secrète : générez-en une longue et aléatoire.
# Exemple : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Mode de paiement (sandbox par défaut). Mettre "live" uniquement
# quand le prestataire officiel sera branché dans payment_service.py.
PAYMENT_MODE=sandbox

# (Optionnel) Mot de passe du compte administrateur créé par "flask seed".
# Ne pas utiliser en production.
ADMIN_PASSWORD=
